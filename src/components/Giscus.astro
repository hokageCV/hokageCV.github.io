---

<div class="giscus"></div>

<script is:inline>
  function getSiteTheme() {
    var theme = document.documentElement.getAttribute('data-theme')
    if (theme === 'dark' || theme === 'light') return theme
    try {
      var saved = localStorage.getItem('site-ki-theme')
      if (saved === 'dark' || saved === 'light') return saved
    } catch (e) {}
    return 'dark'
  }

  function getGiscusThemeUrl() {
    var theme = getSiteTheme()
    var file = theme === 'dark' ? '/giscus-dark.css' : '/giscus-light.css'
    // Absolute URL required: the stylesheet is fetched inside the giscus iframe.
    // Built from origin so it works in dev (localhost) and production.
    return new URL(file, window.location.origin).href
  }

  function loadGiscus() {
    if (document.querySelector('script[src="https://giscus.app/client.js"]')) return
    var script = document.createElement('script')
    script.src = 'https://giscus.app/client.js'
    script.setAttribute('data-repo', 'hokageCV/hokageCV.github.io')
    script.setAttribute('data-repo-id', 'R_kgDOJotCCg')
    script.setAttribute('data-category', 'Announcements')
    script.setAttribute('data-category-id', 'DIC_kwDOJotCCs4C6X5d')
    script.setAttribute('data-mapping', 'pathname')
    script.setAttribute('data-strict', '0')
    script.setAttribute('data-reactions-enabled', '1')
    script.setAttribute('data-emit-metadata', '0')
    script.setAttribute('data-input-position', 'bottom')
    script.setAttribute('data-theme', getGiscusThemeUrl())
    script.setAttribute('data-lang', 'en')
    script.setAttribute('crossorigin', 'anonymous')
    script.async = true
    document.body.appendChild(script)
  }

  function updateGiscusTheme() {
    var iframe = document.querySelector('iframe.giscus-frame')
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: getGiscusThemeUrl() } } },
        'https://giscus.app'
      )
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    loadGiscus()
  })

  var observer = new MutationObserver(function () {
    updateGiscusTheme()
  })

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme']
  })
</script>

<style>
  .giscus {
    width: 100%;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-l);
  }
</style>
