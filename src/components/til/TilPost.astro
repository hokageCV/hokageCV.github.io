---
import BlogPostTags from '@/components/blogs/BlogPostTags.astro'

const { data, Content } = Astro.props
---

<div>
  <small>
    {
      new Date(data.published_date).toLocaleDateString('en-US', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
      })
    }
  </small>

  <h1>{data.title}</h1>

  {
    data.tags && data.tags.length > 0 && (
      <BlogPostTags tags={data.tags} />
    )
  }

  <article>
    <Content />
  </article>
</div>
