---
import { getTilIndexList } from '@/utils/collection'
import { readableDate } from '@/utils/date'
import { render } from 'astro:content'

const til_list = await getTilIndexList()
---

<section>
  {
    await Promise.all(
      til_list.map(async (post) => {
        const { Content } = await render(post)
        const is_blog = post.collection === 'blogs'
        const href = is_blog ? `/blogs/${post.id}` : `/til/${post.id}`

        return (
          <article class='card'>
            <a href={href} class='title'>
              {post.data.title}
            </a>

            <div class='til-date'>{readableDate(post.data.published_date)}</div>

            <div class='preview' aria-hidden='true'>
              <div class='body'>
                <Content />
              </div>
              <div class='fade' aria-hidden='true' />
            </div>

            <a href={href} class='read-more'>
              Read more →
            </a>
          </article>
        )
      }),
    )
  }
</section>

<style>
  section {
    width: 75%;
    max-width: 80%;
    display: flex;
    justify-content: center;
    flex-direction: column;

    margin-bottom: var(--space-l);

    .card {
      border: none;
      background: none;

      padding: var(--space-s) 0;
      margin: 0 0 var(--space-l);

      width: 100%;
      max-width: 100%;

      box-sizing: border-box;

      .title {
        font-size: var(--step-2);
        color: var(--page-heading-color);
        text-decoration: none;

        &:hover {
          color: var(--accent);
        }
      }

      .til-date {
        margin-top: 2px;
        font-size: var(--step--2);
        color: grey;
      }

      .preview {
        position: relative;
        display: block;
        margin-top: var(--space-s);
        text-decoration: none;
        color: inherit;
      }

      .body {
        max-height: 12rem;
        overflow: hidden;
        min-width: 0;
        mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
      }

      .fade {
        position: absolute;
        inset: auto 0 0 0;
        height: 6rem;
        pointer-events: none;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        mask-image: linear-gradient(to bottom, transparent, black 65%);
        -webkit-mask-image: linear-gradient(to bottom, transparent, black 65%);
      }

      .read-more {
        display: inline-block;
        margin-top: var(--space-2xs);
        font-size: var(--step--1);
        color: var(--accent);
        text-decoration: none;

        &:hover {
          text-decoration: underline;
          text-decoration-thickness: 1px;
          text-underline-offset: 3px;
        }
      }
    }

    @media (max-width: 768px) {
      width: 100%;
      max-width: 100%;

      .card {
        width: 100%;
        max-width: 100%;
        margin: var(--space-xs) 0;
      }
    }
  }
</style>
