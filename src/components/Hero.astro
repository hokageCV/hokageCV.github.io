---
import BlogList from '@/components/blogs/BlogList.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import { getFeaturedProjects } from '@/utils/collection'

const featuredProjects = await getFeaturedProjects()
---

<div>
  <section class='intro'>
    <h2 class='name'>Chaitanya Varu</h2>
    <p>Sharing my learnings on backend systems and developer workflows.</p>
  </section>

  <section class='recent'>
    <h2 class='section-title'>Recent Posts</h2>
    <BlogList count={5} />
  </section>

  <section class='featured'>
    <h2 class='section-title'>Projects</h2>
    <div class='featured-grid'>
      {featuredProjects.map((project, index) => <ProjectCard {project} index={index} />)}
    </div>
  </section>

  <div class='bottom-border'></div>
</div>

<style>
  div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2xl);
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    box-sizing: border-box;

    h2 {
      color: var(--page-heading-color);
    }

    section {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .intro {
      text-align: center;
      padding-inline: var(--space-s);
    }
    .intro p {
      margin: 0;
      max-width: 60ch;
    }
    .name {
      font-size: var(--step-4);
    }
    .section-title {
      font-size: var(--step-2);
    }
    .recent {
      width: 100%;
    }
    .featured-grid {
      width: 100%;
      max-width: 1100px;
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .bottom-order {
      margin-bottom: var(--space-m);
    }
  }

  @media (max-width: 768px) {
    div {
      gap: var(--space-xl);
    }
    .featured-grid {
      gap: var(--space-s);
    }
  }
</style>
