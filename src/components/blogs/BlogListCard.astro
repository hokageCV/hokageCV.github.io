---
import { readableDate } from '@/utils/date'

const { post, basePath = '/blogs' } = Astro.props
const url = `${basePath}/${post.id}`
---

<li>
    <div>
      <small>{readableDate(post.data.published_date, 'dd-LL-yyyy')}</small>
      {post.data.favorite && <span class="favorite-star">★</span>}
      <a href={url}>{post.data.title}</a>
    </div>
</li>

<style>
  li {
    list-style: none;
    margin-bottom: var(--space-xs);

    div {
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      align-items: baseline;
      gap: var(--space-xs);

      small {
        font-size: var(--step--2);
        color: grey;
        flex-shrink: 0;
      }

      .favorite-star {
        color: #f5a623;
        flex-shrink: 0;
        width: 1em;
        text-align: center;
      }

      a {
        text-decoration: none;
      }
    }
  }

  @media (max-width: 600px) {
    li div {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-2xs);
      row-gap: 2px;

      small {
        font-size: var(--step--3);
      }

      a {
        flex-basis: 100%;
        min-width: 0;
      }
    }
  }
</style>
