---
import ContactForm from '@/components/contact/ContactForm.astro'
import socials from '@/data/socials'
import Base from '@/layouts/Base.astro'

import ResumeBtn from '@/components/contact/ResumeBtn.astro'
---

<Base>
  <section>
    <ul>
      {
        socials.map((social) => (
          <li>
            <a href={social.url} target='_blank'>
              {social.label}
            </a>
          </li>
        ))
      }
      <ResumeBtn />
    </ul>
    <ContactForm />
  </section>
</Base>

<style>
  section {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: var(--space-s);
    margin: var(--space-m);
    margin-top: 0;
    padding-top: 0;

    ul {
      display: flex;
      flex-wrap: wrap;
      list-style: none;
      gap: var(--space-m);
      padding: 0;
      margin: 0 0 var(--space-s);
    }

    @media (min-width: 768px) {
      width: 50%;
    }

    @media (max-width: 768px) {
      margin: 0;
      padding: 0;
    }
  }
</style>
