---
import ContactForm from '@/components/contact/ContactForm.astro'
import socials from '@/data/socials'
import Base from '@/layouts/Base.astro'

import ResumeBtn from '@/components/contact/ResumeBtn.astro'
---

<Base>
  <div class='contact-page'>
    <div class='page-header'>
      <h1>Contact</h1>
      <p>Find me on socials below, or send a message directly.</p>
    </div>
    <ul class='socials'>
      {
        socials.map((social) => (
          <li>
            <a href={social.url} target='_blank'>
              {social.label}
            </a>
          </li>
        ))
      }
      <ResumeBtn />
    </ul>
    <ContactForm />
  </div>
</Base>

<style>
  .contact-page {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding-inline: var(--space-s);
    box-sizing: border-box;
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-m);
  }

  .page-header h1 {
    margin-block-end: var(--space-2xs);
  }

  .page-header p {
    margin: 0;
    color: var(--base-text);
    opacity: 0.76;
    font-size: var(--step-0);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    list-style: none;
    gap: var(--space-m);
    padding: 0;
    margin: 0 0 var(--space-m);
  }
</style>
